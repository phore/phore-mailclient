{
  "name": "phore/mail-client",
  "type": "library",
  "description": "A typed PHP API for reading IMAP mailboxes and creating Markdown drafts.",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/phore/phore-markdown"
    }
  ],
  "autoload": {
    "psr-4": {
      "Phore\\MailClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Phore\\MailClient\\Test\\": "test/"
    }
  },
  "require": {
    "php": ">=8.5",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-zip": "*",
    "phore/markdown": "dev-main",
    "webklex/php-imap": "^6.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
