{
  "name": "phore/mail-client",
  "type": "library",
  "description": "Immutable email values and a safe IMAP client with reviewable drafts.",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Phore\\MailClient\\": "src/"
    }
  },
  "require": {
    "php": ">=8.5",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-zip": "*",
    "phore/markdown": "dev-main",
    "webklex/php-imap": "6.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "autoload-dev": {
    "psr-4": {
      "Phore\\MailClient\\Test\\": "test/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
